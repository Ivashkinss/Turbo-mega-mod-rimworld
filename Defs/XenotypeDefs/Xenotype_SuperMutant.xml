<?xml version="1.0" encoding="utf-8"?>
<!-- Super mutant xenotype: huge green mutants created by the FEV virus. Biotech only. -->
<Defs>
  <XenotypeDef MayRequire="Ludeon.RimWorld.Biotech">
    <defName>TMM_SuperMutant</defName>
    <label>super mutant</label>
    <description>Huge green mutants created by the Forced Evolutionary Virus (FEV). Exceptionally strong, tough and immune to toxins, though simple-minded and slow to learn.</description>
    <descriptionShort>Huge green mutants created by the FEV virus. Exceptionally strong, robust and toxic-immune, but slow to learn.</descriptionShort>
    <iconPath>UI/Icons/TMM/Xenotypes/TMM_SuperMutant</iconPath>
    <inheritable>true</inheritable>
    <combatPowerFactor>1.4</combatPowerFactor>
    <genes>
      <!-- Appearance & Body -->
      <li>Skin_Green</li>
      <li>Body_Hulk</li>
      <li>Hair_BaldOnly</li>
      <li>Beard_NoBeardOnly</li>
      <li>TMM_Head_SuperMutant</li>
      <li>TMM_Body_Giant</li>
      <li>TMM_Body_SuperMutant</li>
      <!-- Physical Prowess & Durability -->
      <li>MeleeDamage_Strong</li>
      <li>Robust</li>
      <li>ToxResist_Total</li>
      <li>ToxicEnvironmentResistance_Total</li>
      <li>Pain_Reduced</li>
      <!-- Mental / Learning -->
      <li>Learning_Slow</li>
      <li>TMM_Metabolism_Mutant</li>
    </genes>
  </XenotypeDef>
</Defs>
