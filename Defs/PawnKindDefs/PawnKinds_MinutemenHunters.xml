<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- 1. Minuteman Militiaman -->
  <PawnKindDef ParentName="OutlanderBase">
    <defName>TMM_HuntersMilitiaman</defName>
    <label>minuteman militiaman</label>
    <defaultFactionDef>TMM_MinutemenHuntersFaction</defaultFactionDef>
    <combatPower>55</combatPower>
    <isFighter>true</isFighter>
    <gearHealthRange>0.7~1.8</gearHealthRange>
    <itemQuality>Normal</itemQuality>
    <apparelTags>
      <li>IndustrialBasic</li>
      <li>IndustrialMilitaryBasic</li>
    </apparelTags>
    <apparelRequired>
      <li>Apparel_Pants</li>
      <li>Apparel_CollarShirt</li>
    </apparelRequired>
    <apparelMoney>400~800</apparelMoney>
    <apparelAllowHeadgearChance>0.6</apparelAllowHeadgearChance>
    <weaponTags>
      <li>SimpleGun</li>
      <li>Revolver</li>
    </weaponTags>
    <weaponMoney>300~600</weaponMoney>
    <initialWillRange>1~3</initialWillRange>
    <initialResistanceRange>12~20</initialResistanceRange>
  </PawnKindDef>

  <!-- 2. Monster Hunter -->
  <PawnKindDef ParentName="OutlanderBase">
    <defName>TMM_HuntersHunter</defName>
    <label>monster hunter</label>
    <defaultFactionDef>TMM_MinutemenHuntersFaction</defaultFactionDef>
    <combatPower>85</combatPower>
    <isFighter>true</isFighter>
    <gearHealthRange>0.8~2.0</gearHealthRange>
