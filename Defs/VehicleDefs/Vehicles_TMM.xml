  <!-- 5. TMM_Vehicle_Vertibird: Brotherhood of Steel tilt-rotor VTOL gunship/transport -->
  <Vehicles.VehicleDef ParentName="BaseVehiclePawn">
    <defName>TMM_Vehicle_Vertibird</defName>
    <label>Brotherhood Vertibird</label>
    <description>An iconic pre-war tilt-rotor VTOL gunship restored by Brotherhood of Steel scribes. Carries a pilot, a door gunner, and four troopers across vast stretches of the world map like an orbital shuttle, providing rotary suppressive fire on landing.</description>
    <graphicData>
      <texPath>Things/Vehicles/TMM/TMM_Vehicle_Vertibird/TMM_Vehicle_Vertibird</texPath>
      <graphicClass>Vehicles.Graphic_Vehicle</graphicClass>
      <shaderType>CutoutComplex</shaderType>
      <drawSize>(9,9)</drawSize>
      <color>(1,1,1,1)</color>
      <colorTwo>(1,1,1,1)</colorTwo>
    </graphicData>
    <fillPercent>1</fillPercent>
    <buildDef>TMM_Vehicle_Vertibird_Blueprint</buildDef>
    <size>(5,7)</size>
    <vehicleCategory>Transport</vehicleCategory>
    <techLevel>Spacer</techLevel>
    <vehicleType>Air</vehicleType>
    <statBases>
      <ArmorRating_Blunt>0.55</ArmorRating_Blunt>
      <ArmorRating_Sharp>0.75</ArmorRating_Sharp>
