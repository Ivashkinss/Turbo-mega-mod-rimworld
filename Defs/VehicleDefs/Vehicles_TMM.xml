          <slotsToOperate>1</slotsToOperate>
          <handlingTypes>Turret</handlingTypes>
          <turretIds>
            <li>doorGun</li>
          </turretIds>
        </li>
        <li>
          <key>passenger</key>
          <label>trooper</label>
          <slots>4</slots>
        </li>
      </roles>
    </properties>
    <components>
      <li>
        <key>Turbines</key>
        <label>twin tilt-rotors</label>
        <health>380</health>
        <depth>External</depth>
        <categories>
          <li>FlightSpeed</li>
          <li>MoveSpeed</li>
        </categories>
      </li>
      <li>
        <key>Avionics</key>
        <label>flight avionics</label>
        <health>240</health>
        <depth>Internal</depth>
        <categories>
          <li>FlightControl</li>
        </categories>
      </li>
      <li>
        <key>CargoBay</key>
        <label>troop bay</label>
        <health>420</health>
        <depth>Internal</depth>
        <categories>
          <li>CargoCapacity</li>
        </categories>
      </li>
      <li>
        <key>Hull</key>
        <label>armored fuselage</label>
        <health>1100</health>
        <depth>External</depth>
      </li>
    </components>
    <comps>
      <li Class="Vehicles.CompProperties_FueledTravel">
        <fuelType>Chemfuel</fuelType>
        <leakDef>Filth_Fuel</leakDef>
        <fuelConsumptionRate>35</fuelConsumptionRate>
        <fuelConsumptionWorldMultiplier>0.8</fuelConsumptionWorldMultiplier>
        <fuelCapacity>600</fuelCapacity>
      </li>
      <li Class="Vehicles.CompProperties_VehicleLauncher">
        <fuelConsumptionWorldMultiplier>80</fuelConsumptionWorldMultiplier>
        <launchProtocol Class="Vehicles.DefaultTakeoff">
          <launchProperties>
            <maxTicks>240</maxTicks>
            <forcedRotation>East</forcedRotation>
            <renderShadow>true</renderShadow><lockShadowZ>true</lockShadowZ>
            <zPositionCurve><points><li>(0, 0)</li><li>(0.25, 0.25)</li><li>(0.6, 1.6)</li><li>(1, 3.5)</li></points></zPositionCurve>
            <shadowAlphaCurve><points><li>(0, 1)</li><li>(0.6, 0.75)</li><li>(1, 0.4)</li></points></shadowAlphaCurve>
            <shadowSizeXCurve><points><li>(0, 4.5)</li><li>(1, 3)</li></points></shadowSizeXCurve>
            <shadowSizeZCurve><points><li>(0, 2.5)</li><li>(1, 1.7)</li></points></shadowSizeZCurve>
          </launchProperties>
          <landingProperties>
            <maxTicks>240</maxTicks>
            <forcedRotation>East</forcedRotation>
            <renderShadow>true</renderShadow><lockShadowZ>true</lockShadowZ>
            <zPositionCurve><points><li>(0, 3.5)</li><li>(0.4, 1.6)</li><li>(0.75, 0.25)</li><li>(1, 0)</li></points></zPositionCurve>
            <shadowAlphaCurve><points><li>(0, 0.4)</li><li>(0.4, 0.75)</li><li>(1, 1)</li></points></shadowAlphaCurve>
            <shadowSizeXCurve><points><li>(0, 3)</li><li>(1, 4.5)</li></points></shadowSizeXCurve>
            <shadowSizeZCurve><points><li>(0, 1.7)</li><li>(1, 2.5)</li></points></shadowSizeZCurve>
          </landingProperties>
        </launchProtocol>
        <fixedLaunchDistanceMax>200</fixedLaunchDistanceMax>
      </li>
      <li Class="Vehicles.CompProperties_VehicleTurrets">
        <turrets>
          <li>
            <turretDef>TMM_Turret_VertibirdDoorGun</turretDef>
            <renderProperties>
              <north>(0.9, -0.2)</north>
              <south>(-0.9, 0.2)</south>
              <east>(0.2, -0.5)</east>
            </renderProperties>
            <gizmoLabel>door rotary gun</gizmoLabel>
            <aimPieOffset>(0, 0)</aimPieOffset>
            <key>doorGun</key>
          </li>
        </turrets>
      </li>
    </comps>
  </Vehicles.VehicleDef>

