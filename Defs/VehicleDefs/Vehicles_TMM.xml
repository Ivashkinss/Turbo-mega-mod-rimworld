<?xml version="1.0" encoding="utf-8"?>
<!-- Vehicles of Turbo mega mod on the integrated Vehicle Framework (SmashPhil, MIT, v1.6.2144).
     Graphics use vanilla CutoutComplex shader (VF AssetBundle RGB shaders are not loaded in RimWorld 1.7). -->
<Defs>

  <!-- 1. TMM_Vehicle_Impala: 1967 black sedan ("Baby") of the Winchester brothers -->
  <Vehicles.VehicleDef ParentName="BaseVehiclePawn">
    <defName>TMM_Vehicle_Impala</defName>
    <label>1967 black sedan</label>
    <description>A sleek, rumbling 1967 four-door hardtop sedan — lovingly called "Baby" by monster hunters. Blistering fast on roads and open ground, seats four, and hides a warded trunk built for salt, silver, and an arsenal of hunting weapons.</description>
    <graphicData>
      <texPath>Things/Vehicles/TMM/TMM_Vehicle_Impala/TMM_Vehicle_Impala</texPath>
      <graphicClass>Vehicles.Graphic_Vehicle</graphicClass>
      <shaderType>CutoutComplex</shaderType>
      <drawSize>(5,5)</drawSize>
      <color>(1,1,1,1)</color>
      <colorTwo>(1,1,1,1)</colorTwo>
    </graphicData>
    <fillPercent>0.85</fillPercent>
    <buildDef>TMM_Vehicle_Impala_Blueprint</buildDef>
    <size>(2,4)</size>
    <vehicleCategory>Transport</vehicleCategory>
    <techLevel>Industrial</techLevel>
    <vehicleType>Land</vehicleType>
    <statBases>
      <ArmorRating_Blunt>0.2</ArmorRating_Blunt>
      <ArmorRating_Sharp>0.3</ArmorRating_Sharp>
      <ArmorRating_Heat>0.25</ArmorRating_Heat>
      <Flammability>0.4</Flammability>
      <MarketValue>3800</MarketValue>
    </statBases>
    <vehicleStats>
      <Mass>180</Mass>
      <MoveSpeed>13.5</MoveSpeed>
      <CargoCapacity>220</CargoCapacity>
      <RepairRate>0.6</RepairRate>
    </vehicleStats>
    <race>
      <baseBodySize>2.6</baseBodySize>
    </race>
    <properties>
      <worldSpeedMultiplier>4.0</worldSpeedMultiplier>
      <visibilityWeight>2.5</visibilityWeight>
      <roles>
        <li>
          <key>driver</key>
          <label>driver</label>
          <slots>1</slots>
          <slotsToOperate>1</slotsToOperate>
          <handlingTypes>Movement</handlingTypes>
        </li>
        <li>
          <key>passenger</key>
          <label>passenger</label>
          <slots>3</slots>
        </li>
      </roles>
    </properties>
    <components>
      <li>
        <key>Engine</key>
        <label>V8 engine</label>
        <health>200</health>
        <depth>Internal</depth>
        <categories>
          <li>MoveSpeed</li>
        </categories>
      </li>
      <li>
        <key>Wheels</key>
        <label>wheels</label>
        <health>200</health>
        <depth>External</depth>
        <categories>
          <li>MoveSpeed</li>
        </categories>
      </li>
      <li>
        <key>Trunk</key>
        <label>warded trunk</label>
        <health>240</health>
        <depth>External</depth>
        <categories>
          <li>CargoCapacity</li>
        </categories>
      </li>
      <li>
        <key>Body</key>
        <label>chassis</label>
        <health>480</health>
        <depth>External</depth>
      </li>
    </components>
    <comps>
      <li Class="Vehicles.CompProperties_FueledTravel">
        <fuelType>Chemfuel</fuelType>
        <leakDef>Filth_Fuel</leakDef>
        <fuelConsumptionRate>12</fuelConsumptionRate>
        <fuelConsumptionWorldMultiplier>15</fuelConsumptionWorldMultiplier>
        <fuelCapacity>70</fuelCapacity>
