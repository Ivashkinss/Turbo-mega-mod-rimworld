<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <HediffDef>
    <defName>TMM_Hediff_HiddenSynth</defName>
    <label>unusual neural signature</label>
    <description>Subtle anomalies in sleep patterns and micro-expressions suggest this colonist may have been replaced by an Institute synth.</description>
    <isBad>false</isBad>
    <everCurableByItem>false</everCurableByItem>
    <stages>
      <li>
        <becomeVisible>false</becomeVisible>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>TMM_Hediff_RevealedSynth</defName>
    <label>Institute synth infiltrator</label>
    <description>Exposed as a third-generation Institute synth replacement. Faster cognitive processing, though unsettling to former friends.</description>
    <isBad>false</isBad>
    <defaultLabelColor>(0.45, 0.85, 0.98)</defaultLabelColor>
    <stages>
      <li>
        <statOffsets>
          <ResearchSpeed>0.15</ResearchSpeed>
          <SocialImpact>-0.15</SocialImpact>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>TMM_Hediff_VaultTecSerum</defName>
    <label>Vault-Tec trial serum</label>
    <description>Residual effects of an experimental Vault-Tec clinical compound: boosted reflexes and work output at the cost of mild jitters.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <defaultLabelColor>(0.95, 0.82, 0.32)</defaultLabelColor>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>360000</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
    <stages>
      <li>
        <statOffsets>
          <WorkSpeedGlobal>0.12</WorkSpeedGlobal>
          <MoveSpeed>0.25</MoveSpeed>
          <MentalBreakThreshold>0.04</MentalBreakThreshold>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>TMM_Hediff_AngelicVessel</defName>
    <label>angelic grace</label>
    <description>Touched by an angel who briefly shared this willing vessel. Enhances healing, consciousness, and resilience.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <defaultLabelColor>(0.85, 0.94, 1.0)</defaultLabelColor>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>900000</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
    <stages>
      <li>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>0.10</offset>
          </li>
        </capMods>
        <statOffsets>
          <InjuryHealingFactor>0.40</InjuryHealingFactor>
          <ImmunityGainSpeed>0.25</ImmunityGainSpeed>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>TMM_Hediff_DemonicPossession</defName>
    <label>demonic possession</label>
    <description>A lesser demon has latched onto this host, surging unnatural strength through their muscles while clouding their sanity.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>true</isBad>
    <defaultLabelColor>(0.88, 0.25, 0.25)</defaultLabelColor>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>240000</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
    <stages>
      <li>
        <painFactor>0.5</painFactor>
        <statOffsets>
          <MeleeDamageFactor>0.25</MeleeDamageFactor>
          <MentalBreakThreshold>0.12</MentalBreakThreshold>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

</Defs>
