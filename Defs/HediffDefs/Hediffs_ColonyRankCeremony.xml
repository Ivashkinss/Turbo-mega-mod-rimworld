<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <HediffDef>
    <defName>TMM_PromotionCeremonyInspiration</defName>
    <label>ceremony inspiration</label>
    <description>Inspired by an unforgettable promotion ceremony. Sharpens focus and boosts social presence for five days.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <defaultLabelColor>(0.95, 0.85, 0.45)</defaultLabelColor>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>300000</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
    <stages>
      <li>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>0.08</offset>
          </li>
        </capMods>
        <statOffsets>
          <SocialImpact>0.15</SocialImpact>
          <NegotiationAbility>0.10</NegotiationAbility>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

</Defs>