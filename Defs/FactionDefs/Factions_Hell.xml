<?xml version="1.0" encoding="utf-8"?>
<!-- Hell (demons), stage 1: a permanent-enemy faction of demon xenotype pawns built on vanilla pirates.
     Biotech only: without Biotech the demon xenotype and this faction are not added (user decision 18.11.2026). -->
<Defs>
  <FactionDef ParentName="PirateBandBase" MayRequire="Ludeon.RimWorld.Biotech">
    <defName>TMM_HellFaction</defName>
    <startingCountAtWorldCreation>1</startingCountAtWorldCreation>
    <maxConfigurableAtWorldCreation>1</maxConfigurableAtWorldCreation>
    <configurationListOrderPriority>106</configurationListOrderPriority>
    <label>legions of Hell</label>
    <description>Demons wearing stolen human vessels. They answer to the King of Hell, strike from hidden ritual sites and crossroads altars, and trade only in contracts whose price comes due later.</description>
    <pawnSingular>demon</pawnSingular>
    <pawnsPlural>demons</pawnsPlural>
    <leaderTitle>King of Hell</leaderTitle>
    <fixedName>Demons of Hell</fixedName>
    <requiredCountAtGameStart>1</requiredCountAtGameStart>
    <settlementGenerationWeight>0.3</settlementGenerationWeight>
    <listOrderPriority>11</listOrderPriority>
    <colorSpectrum Inherit="False">
      <li>(0.45, 0.05, 0.05)</li>
      <li>(0.75, 0.2, 0.1)</li>
    </colorSpectrum>
    <xenotypeSet Inherit="False">
      <xenotypeChances>
        <TMM_Demon>1</TMM_Demon>
      </xenotypeChances>
    </xenotypeSet>
  </FactionDef>
</Defs>
