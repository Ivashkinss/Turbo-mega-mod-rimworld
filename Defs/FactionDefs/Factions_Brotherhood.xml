    <settlementGenerationWeight>0.4</settlementGenerationWeight>
    <listOrderPriority>15</listOrderPriority>
    <colorSpectrum Inherit="False">
      <li>(0.45, 0.45, 0.5)</li>
      <li>(0.7, 0.55, 0.25)</li>
    </colorSpectrum>
  </FactionDef>
</Defs>