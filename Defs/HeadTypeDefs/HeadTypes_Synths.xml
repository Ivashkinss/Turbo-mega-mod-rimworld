<?xml version="1.0" encoding="utf-8"?>
<!-- Custom HeadTypeDefs for Institute synths (Gen 1-3), Nick Valentine, P.A.M., and President John Henry Eden. -->
<Defs>

  <HeadTypeDef ParentName="AverageBase" MayRequire="Ludeon.RimWorld.Biotech">
    <defName>TMM_SynthGen1Head</defName>
    <graphicPath>Things/TMM/Xenotypes/Synths/Heads/TMM_SynthGen1Head</graphicPath>
    <randomChosen>false</randomChosen>
    <gender>None</gender>
    <requiredGenes>
      <li>TMM_Head_SynthGen1</li>
    </requiredGenes>
    <eyeOffsetEastWest>(0.15, 0, 0.175)</eyeOffsetEastWest>
  </HeadTypeDef>

