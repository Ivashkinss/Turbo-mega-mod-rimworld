<?xml version="1.0" encoding="utf-8"?>
<!-- Genes for Institute synths (Gen 1-3) and autonomous robot chassis (P.A.M., Eden). Biotech only. -->
<Defs>

  <!-- ==================== Skin Overrides ==================== -->

  <GeneDef ParentName="GeneSkinColorOverride" MayRequire="Ludeon.RimWorld.Biotech">
    <defName>TMM_Skin_FullColorChassis</defName>
    <label>alloy finish</label>
    <description>Unpigmented neutral multiplier so painted steel, composite plating, and glowing optics render in true colors.</description>
    <iconPath>UI/Icons/TMM/Genes/TMM_Skin_FullColorChassis</iconPath>
    <skinColorOverride>(255, 255, 255)</skinColorOverride>
    <displayOrderInCategory>95</displayOrderInCategory>
    <canGenerateInGeneSet>false</canGenerateInGeneSet>
  </GeneDef>

  <GeneDef ParentName="GeneSkinColorOverride" MayRequire="Ludeon.RimWorld.Biotech">
    <defName>TMM_Skin_SynthGen2</defName>
    <label>polymer skin</label>
    <description>Weathered matte-grey synthetic rubber stretched over a Gen 2 synth frame.</description>
    <iconPath>UI/Icons/TMM/Genes/TMM_Skin_SynthGen2</iconPath>
    <skinColorOverride>(186, 190, 188)</skinColorOverride>
    <displayOrderInCategory>96</displayOrderInCategory>
    <canGenerateInGeneSet>false</canGenerateInGeneSet>
  </GeneDef>

  <!-- ==================== Head Genes ==================== -->

  <GeneDef ParentName="GeneJawBase" MayRequire="Ludeon.RimWorld.Biotech">
    <defName>TMM_Head_SynthGen1</defName>
    <label>android skull</label>
    <description>An exposed Institute Gen 1 mechanical cranium with articulated jaw pistons and glowing optic lenses.</description>
    <iconPath>UI/Icons/TMM/Genes/TMM_Head_SynthGen1</iconPath>
    <canGenerateInGeneSet>false</canGenerateInGeneSet>
    <forcedHeadTypes>
      <li>TMM_SynthGen1Head</li>
    </forcedHeadTypes>
  </GeneDef>

  <GeneDef ParentName="GeneJawBase" MayRequire="Ludeon.RimWorld.Biotech">
    <defName>TMM_Head_SynthGen2</defName>
    <label>polymer cranium</label>
    <description>A Gen 2 synthetic head covered in grey polymer skin with visible mechanical seams at the temples and jaw.</description>
    <iconPath>UI/Icons/TMM/Genes/TMM_Head_SynthGen2</iconPath>
    <canGenerateInGeneSet>false</canGenerateInGeneSet>
    <forcedHeadTypes>
      <li>TMM_SynthGen2Head</li>
    </forcedHeadTypes>
  </GeneDef>

  <GeneDef ParentName="GeneJawBase" MayRequire="Ludeon.RimWorld.Biotech">
    <defName>TMM_Head_SynthGen3</defName>
    <label>synthetic likeness</label>
    <description>A biologically indistinguishable human head marked only by a hairline surgical seam at the temple and faint ocular rings.</description>
    <iconPath>UI/Icons/TMM/Genes/TMM_Head_SynthGen3</iconPath>
    <canGenerateInGeneSet>false</canGenerateInGeneSet>
    <forcedHeadTypes>
      <li>TMM_SynthGen3Head_Male</li>
      <li>TMM_SynthGen3Head_Female</li>
    </forcedHeadTypes>
  </GeneDef>

  <GeneDef ParentName="GeneJawBase" MayRequire="Ludeon.RimWorld.Biotech">
    <defName>TMM_Head_RobotChassis</defName>
    <label>optical sensor unit</label>
    <description>A steel military sensor head with a central cyclops optic and telemetry vents, replaceable with specialized AI display modules.</description>
    <iconPath>UI/Icons/TMM/Genes/TMM_Head_RobotChassis</iconPath>
    <canGenerateInGeneSet>false</canGenerateInGeneSet>
    <forcedHeadTypes>
      <li>TMM_PAMHead</li>
    </forcedHeadTypes>
  </GeneDef>

  <!-- ==================== Body Genes ==================== -->

  <GeneDef MayRequire="Ludeon.RimWorld.Biotech">
    <defName>TMM_Body_SynthGen1</defName>
    <label>skeletal endoskeleton</label>
    <description>A lean, exposed Institute alloy endoskeleton with synthetic cabling and white composite chest plates.</description>
    <geneClass>TurboMegaMod.Gene_ForceBodyType</geneClass>
    <iconPath>UI/Icons/TMM/Genes/TMM_Body_SynthGen1</iconPath>
    <displayCategory>Cosmetic</displayCategory>
    <biostatCpx>1</biostatCpx>
    <canGenerateInGeneSet>false</canGenerateInGeneSet>
    <modExtensions>
      <li Class="TurboMegaMod.GeneCustomBodyExtension">
        <bodyType>TMM_SynthGen1</bodyType>
      </li>
    </modExtensions>
  </GeneDef>

  <GeneDef MayRequire="Ludeon.RimWorld.Biotech">
    <defName>TMM_Body_RobotChassis</defName>
    <label>armored robot chassis</label>
    <description>A heavy, self-contained Assaultron-derived steel chassis with integrated plating and articulated limbs.</description>
    <geneClass>TurboMegaMod.Gene_ForceBodyType</geneClass>
    <iconPath>UI/Icons/TMM/Genes/TMM_Body_RobotChassis</iconPath>
    <displayCategory>Cosmetic</displayCategory>
    <biostatCpx>1</biostatCpx>
    <canGenerateInGeneSet>false</canGenerateInGeneSet>
    <modExtensions>
      <li Class="TurboMegaMod.GeneCustomBodyExtension">
        <bodyType>TMM_RobotChassis</bodyType>
      </li>
    </modExtensions>
  </GeneDef>

  <!-- ==================== Physiology, Armor & Restrictions ==================== -->

  <GeneDef MayRequire="Ludeon.RimWorld.Biotech">
    <defName>TMM_Synth_NoFood</defName>
    <label>internal power cell</label>
    <description>Powered by a sealed micro-fusion cell rather than organic digestion. Completely removes the need for food.</description>
    <iconPath>UI/Icons/TMM/Genes/TMM_Synth_NoFood</iconPath>
    <displayCategory>Miscellaneous</displayCategory>
    <biostatCpx>2</biostatCpx>
    <biostatMet>0</biostatMet>
    <canGenerateInGeneSet>false</canGenerateInGeneSet>
    <disablesNeeds> <!-- CHECK API -->
      <li>Food</li>
    </disablesNeeds>
  </GeneDef>

  <GeneDef MayRequire="Ludeon.RimWorld.Biotech">
    <defName>TMM_Chassis_NoApparel</defName>
    <label>sealed alloy hull</label>
    <description>This robotic chassis cannot wear human clothing or armor; its integrated steel hull provides all environmental and combat protection.</description>
    <geneClass>TurboMegaMod.Gene_NoApparel</geneClass>
    <iconPath>UI/Icons/TMM/Genes/TMM_Chassis_NoApparel</iconPath>
    <displayCategory>Miscellaneous</displayCategory>
    <biostatCpx>1</biostatCpx>
    <biostatMet>0</biostatMet>
    <canGenerateInGeneSet>false</canGenerateInGeneSet>
    <statOffsets>
      <ComfyTemperatureMin>-40</ComfyTemperatureMin>
      <ComfyTemperatureMax>45</ComfyTemperatureMax>
    </statOffsets>
  </GeneDef>

  <GeneDef MayRequire="Ludeon.RimWorld.Biotech">
    <defName>TMM_Synth_MechanicalArmor</defName>
    <label>composite endoskeleton</label>
    <description>Reinforced steel struts and ceramic chest shells provide built-in ballistic and heat protection and dull pain feedback.</description>
    <iconPath>UI/Icons/TMM/Genes/TMM_Synth_MechanicalArmor</iconPath>
    <displayCategory>Violence</displayCategory>
    <biostatCpx>2</biostatCpx>
    <biostatMet>-2</biostatMet>
    <canGenerateInGeneSet>false</canGenerateInGeneSet>
    <painFactor>0.25</painFactor>
    <statOffsets>
      <ArmorRating_Sharp>0.28</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.22</ArmorRating_Blunt>
      <ArmorRating_Heat>0.35</ArmorRating_Heat>
    </statOffsets>
    <statFactors>
      <Flammability>0.25</Flammability>
    </statFactors>
  </GeneDef>

  <GeneDef MayRequire="Ludeon.RimWorld.Biotech">
    <defName>TMM_Synth_LightPlating</defName>
    <label>sub-dermal alloy frame</label>
    <description>The underlying metal chassis beneath the polymer skin absorbs impacts better than human bone.</description>
    <iconPath>UI/Icons/TMM/Genes/TMM_Synth_LightPlating</iconPath>
    <displayCategory>Violence</displayCategory>
    <biostatCpx>1</biostatCpx>
    <biostatMet>-1</biostatMet>
    <canGenerateInGeneSet>false</canGenerateInGeneSet>
    <painFactor>0.5</painFactor>
    <statOffsets>
      <ArmorRating_Sharp>0.16</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.14</ArmorRating_Blunt>
      <ArmorRating_Heat>0.20</ArmorRating_Heat>
    </statOffsets>
    <statFactors>
      <Flammability>0.4</Flammability>
    </statFactors>
  </GeneDef>

  <GeneDef MayRequire="Ludeon.RimWorld.Biotech">
    <defName>TMM_Chassis_SteelArmor</defName>
    <label>military chassis plating</label>
    <description>Thick riveted steel armor built directly into the robot body, offering heavy protection without external gear.</description>
    <iconPath>UI/Icons/TMM/Genes/TMM_Chassis_SteelArmor</iconPath>
    <displayCategory>Violence</displayCategory>
    <biostatCpx>3</biostatCpx>
    <biostatMet>-3</biostatMet>
    <canGenerateInGeneSet>false</canGenerateInGeneSet>
    <painFactor>0.1</painFactor>
    <statOffsets>
      <ArmorRating_Sharp>0.55</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.42</ArmorRating_Blunt>
      <ArmorRating_Heat>0.60</ArmorRating_Heat>
    </statOffsets>
    <statFactors>
      <Flammability>0.1</Flammability>
    </statFactors>
  </GeneDef>

  <GeneDef MayRequire="Ludeon.RimWorld.Biotech">
    <defName>TMM_Synth_UncannyMachine</defName>
    <label>robotic demeanor</label>
    <description>Flat vocal synthesis and an exposed mechanical skull unsettle humans, heavily penalizing social persuasion.</description>
    <iconPath>UI/Icons/TMM/Genes/TMM_Synth_UncannyMachine</iconPath>
    <displayCategory>Miscellaneous</displayCategory>
    <biostatCpx>1</biostatCpx>
    <biostatMet>2</biostatMet>
    <canGenerateInGeneSet>false</canGenerateInGeneSet>
    <aptitudes>
      <Social>-6</Social>
    </aptitudes>
    <statOffsets>
      <SocialImpact>-0.40</SocialImpact>
    </statOffsets>
  </GeneDef>

  <GeneDef MayRequire="Ludeon.RimWorld.Biotech">
    <defName>TMM_Synth_PolymerFace</defName>
    <label>uncanny visage</label>
    <description>Stiff synthetic features slightly hinder casual social rapport, though skilled communicators can overcome it.</description>
    <iconPath>UI/Icons/TMM/Genes/TMM_Synth_PolymerFace</iconPath>
    <displayCategory>Miscellaneous</displayCategory>
    <biostatCpx>1</biostatCpx>
    <biostatMet>1</biostatMet>
    <canGenerateInGeneSet>false</canGenerateInGeneSet>
    <statOffsets>
      <SocialImpact>-0.15</SocialImpact>
    </statOffsets>
  </GeneDef>

  <GeneDef MayRequire="Ludeon.RimWorld.Biotech">
    <defName>TMM_Synth_NeuralComponent</defName>
    <label>synth neural component</label>
    <description>An embedded Institute neural processor subtly enhances cognitive speed, research output, and emotional steadiness.</description>
    <iconPath>UI/Icons/TMM/Genes/TMM_Synth_NeuralComponent</iconPath>
    <displayCategory>Miscellaneous</displayCategory>
    <biostatCpx>2</biostatCpx>
    <biostatMet>-1</biostatMet>
    <canGenerateInGeneSet>false</canGenerateInGeneSet>
    <statOffsets>
      <ResearchSpeed>0.10</ResearchSpeed>
      <MentalBreakThreshold>-0.04</MentalBreakThreshold>
    </statOffsets>
  </GeneDef>

  <GeneDef MayRequire="Ludeon.RimWorld.Biotech">
    <defName>TMM_Chassis_LogicCore</defName>
    <label>analytical processor</label>
    <description>Dedicated predictive and strategic co-processors accelerate research and steady decision-making under fire.</description>
    <iconPath>UI/Icons/TMM/Genes/TMM_Chassis_LogicCore</iconPath>
    <displayCategory>Miscellaneous</displayCategory>
    <biostatCpx>2</biostatCpx>
    <biostatMet>-2</biostatMet>
    <canGenerateInGeneSet>false</canGenerateInGeneSet>
    <statOffsets>
      <ResearchSpeed>0.25</ResearchSpeed>
      <MentalBreakThreshold>-0.08</MentalBreakThreshold>
    </statOffsets>
  </GeneDef>

</Defs>
