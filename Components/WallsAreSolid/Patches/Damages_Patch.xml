<?xml version="1.0" encoding="utf-8" ?>
<Patch>
	<Operation Class="XmlExtensions.UseSettings">
		<modId>Victor.WallsAreSolid</modId>
		<keys>
			<li>SharpMeleePassable</li>
			<li>SharpMeleeImpassable</li>
			<li>BluntPassable</li>
			<li>BluntImpassable</li>
			<li>SharpRangedPassable</li>
			<li>SharpRangedImpassable</li>
			<li>BombPassable</li>
			<li>BombImpassable</li>
		</keys>
		<defaultValues>
			<li>0.4</li>
			<li>0.1</li>
			<li>0.5</li>
			<li>0.3</li>
			<li>0.2</li>
			<li>0.2</li>
			<li>0.8</li>
			<li>1</li>
		</defaultValues>
		<apply>
			<Operation Class="XmlExtensions.PatchOperationSafeAdd">
				<xpath>Defs/DamageDef[@Name="CutBase" or defName="Cut" or defName="Poke" or defName="Stab" or @Name="Scratch" or @Name="Bite"]</xpath>
					<value>
						<buildingDamageFactorPassable>{SharpMeleePassable}</buildingDamageFactorPassable>
						<buildingDamageFactorImpassable>{SharpMeleeImpassable}</buildingDamageFactorImpassable>
					</value>
			</Operation>
			<Operation Class="XmlExtensions.PatchOperationSafeAdd">
				<xpath>Defs/DamageDef[defName="Blunt" or defName="Crush"]</xpath>
					<value>
						<buildingDamageFactorPassable>{BluntPassable}</buildingDamageFactorPassable>
						<buildingDamageFactorImpassable>{BluntImpassable}</buildingDamageFactorImpassable>
					</value>
			</Operation>
			<Operation Class="XmlExtensions.PatchOperationSafeAdd">
				<xpath>Defs/DamageDef[defName="RangedStab" or @Name="Bullet" or @Name="Arrow"]</xpath>
					<value>
						<buildingDamageFactorPassable>{SharpRangedPassable}</buildingDamageFactorPassable>
						<buildingDamageFactorImpassable>{SharpRangedImpassable}</buildingDamageFactorImpassable>
					</value>
			</Operation>
			<Operation Class="XmlExtensions.PatchOperationSafeReplace">
				<xpath>Defs/DamageDef[@Name="Bomb"]/buildingDamageFactorPassable</xpath>
					<value>
						<buildingDamageFactorPassable>{BombPassable}</buildingDamageFactorPassable>
					</value>
			</Operation>
			<Operation Class="XmlExtensions.PatchOperationSafeReplace">
				<xpath>Defs/DamageDef[@Name="Bomb"]/buildingDamageFactorImpassable</xpath>
					<value>
						<buildingDamageFactorImpassable>{BombImpassable}</buildingDamageFactorImpassable>
					</value>
			</Operation>
		</apply>
	</Operation>
</Patch>
